{
  "name": "reto-03-ordenes-compra-sap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit",
    "modulo": "tsx scripts/empaquetar-modulo.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "lint": "biome lint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.3",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
