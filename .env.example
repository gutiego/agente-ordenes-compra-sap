# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.

# ── Autenticación (obligatoria) ─────────────────────────────────────────────
# JSON token → { usuario, rol }. Roles: analista (chat y creación de OC) o auditor (solo lectura).
# Tokens de al menos 16 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_TOKENS={"cambia-este-token-analista":{"usuario":"ana.compras","rol":"analista"},"cambia-este-token-auditor":{"usuario":"luis.auditoria","rol":"auditor"}}

# ── Base de datos ───────────────────────────────────────────────────────────
# Postgres (p. ej. Neon). Si se deja vacía se usa PGlite local en PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=data

# ── Modelo de lenguaje ──────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Timeout por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000
# Tope de iteraciones herramienta → modelo por turno
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión
MAX_TOKENS_SESION=400000

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# Mensajes de chat por usuario y minuto
LIMITE_CHAT_MINUTO=20
